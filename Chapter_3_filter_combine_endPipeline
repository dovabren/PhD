#!/bin/bash
cd /data3/dova_nanuq_raw_data/Chapter_3/
filename="VZM_filter_end_names.txt"

while read -r sample; do
  echo "📂 Processing sample: $sample"

  input_vcf="${sample}.vcf"
  output_vcf2="${sample}_filter2.vcf"
  output_vcf3="${sample}_filter3.vcf"

  # Check if input file exists
  if [[ ! -f "$input_vcf" ]]; then
    echo "❌ File not found: $input_vcf"
      continue
    fi

    # Convert VCF format
   cat "$input_vcf" |  vcf-convert -v 4.1 > "$output_vcf2"  

  # Filter out Indel and CNV
  grep -v -E "Indel|CNV" "$output_vcf2" > "$output_vcf3"

  echo "✅ Finished processing $sample"
done < "$filename"


