#!/bin/bash

# Set your reference genome path
REFERENCE="/data2/Training_set/HAV3.1_renamed.fa"
GATK_JAR="/usr/local/src/GenomeAnalysisTK.jar"

# List of VCF files to process - change as needed 
VCF_FILES=("V_raw_genotype_noINDEL_noCNV.vcf" "Z_raw_genotype_noINDEL_noCNV.vcf" "M_raw_genotype_noINDEL_noCNV.vcf")

for VCF in "${VCF_FILES[@]}"; do
    echo "Processing $VCF..."

    # Extract the sample names from the header line (starts with a single #)
    SAMPLES=$(awk '/^#CHROM/ {for(i=10;i<=NF;i++) print $i}' "$VCF")

    for SAMPLE in $SAMPLES; do
        # Generate output file name
        BASENAME=$(basename "$VCF" .vcf)
        OUTPUT="${SAMPLE}_${BASENAME}.vcf"

        echo "  Extracting sample: $SAMPLE -> $OUTPUT"
        java -jar "$GATK_JAR" \
            -T SelectVariants \
            -R "$REFERENCE" \
            -V "$VCF" \
            -sn "$SAMPLE" \
            -o "$OUTPUT"
    done
done


###########depth_variant_filtration.sh

#!/bin/bash

REFERENCE="/data2/Training_set/HAV3.1_renamed.fa"
GATK_JAR="/usr/local/src/GenomeAnalysisTK.jar"
THRESHOLD_FILE="V_dp_thresholds.csv" #change as needed per sample

# Directory where your sample-specific VCFs are stored
VCF_DIR="."  # change this if they are in a subfolder

# Skip header and loop through each row
tail -n +2 "$THRESHOLD_FILE" | while IFS=',' read -r SAMPLE LOWER UPPER; do
    SAMPLE=$(echo "$SAMPLE" | tr -d '\r\n')

    echo "Looking for VCF for sample: $SAMPLE"

    # Find the matching input VCF file
    INPUT=$(find "$VCF_DIR" -maxdepth 1 -type f -name "${SAMPLE}_*genotype_noINDEL_noCNV.vcf" | head -n 1)
    if [[ -z "$INPUT" ]]; then
        echo "❌ No VCF file found for $SAMPLE. Skipping..."
         continue
     fi

     BASENAME=$(basename "$INPUT" .vcf)
     OUTPUT="${BASENAME/_genotype_noINDEL_noCNV/_genotype_depth}.vcf"

    echo "✅ Filtering $INPUT with thresholds: DP < $LOWER and DP > $UPPER"
     java -jar "$GATK_JAR" \
         -T VariantFiltration \
         -R "$REFERENCE" \
         -V "$INPUT" \
         --filterExpression "DP < $LOWER" \
         --filterName "LowDPDrone" \
         --filterExpression "DP > $UPPER" \
         --filterName "HighDPDrone" \
         -o "$OUTPUT"
done

